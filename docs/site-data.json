  "groups": [
    {
      "group": "Connection context",
      "features": [
        "dur",
        "proto",
        "service",
        "state"
      ],
      "meaning": "Flow duration, protocol, service and connection state."
    },
    {
      "group": "Traffic volume",
      "features": [
        "spkts",
        "dpkts",
        "sbytes",
        "dbytes",
        "rate",
        "sload",
        "dload",
        "smean",
        "dmean"
      ],
      "meaning": "Directional packets, bytes, transfer rates and mean packet sizes."
    },
    {
      "group": "Packet behavior",
      "features": [
        "sttl",
        "dttl",
        "sloss",
        "dloss"
      ],
      "meaning": "Directional time-to-live and retransmission/loss measurements."
    },
    {
      "group": "Timing",
      "features": [
        "sinpkt",
        "dinpkt",
        "sjit",
        "djit",
        "tcprtt",
        "synack",
        "ackdat"
      ],
      "meaning": "Packet spacing, jitter and TCP handshake timings."
    },
    {
      "group": "TCP state",
      "features": [
        "swin",
        "dwin",
        "stcpb",
        "dtcpb"
      ],
      "meaning": "Directional TCP window sizes and sequence-number bases."
    },
    {
      "group": "Application activity",
      "features": [
        "trans_depth",
        "response_body_len",
        "is_ftp_login",
        "ct_ftp_cmd",
        "ct_flw_http_mthd"
      ],
      "meaning": "HTTP transaction depth, response size and HTTP/FTP activity."
    },
    {
      "group": "Connection history",
      "features": [
        "ct_srv_src",
        "ct_state_ttl",
        "ct_dst_ltm",
        "ct_src_dport_ltm",
        "ct_dst_sport_ltm",
        "ct_dst_src_ltm",
        "ct_src_ltm",
        "ct_srv_dst"
      ],
      "meaning": "Dataset-supplied counts of recent repeated services, endpoints, ports and state/TTL combinations."
    },
    {
      "group": "Endpoint indicator",
      "features": [
        "is_sm_ips_ports"
      ],
      "meaning": "Whether the supplied flow has matching source/destination IPs and ports."
    }
  ],
